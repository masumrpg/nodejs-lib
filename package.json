{
  "name": "nodejs-lib",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "dev:expo-go": "turbo dev --filter='@masumdev/*' --filter=expo-go",
    "dev:native": "turbo dev --filter='@masumdev/*' --filter=expo-go",
    "dev:docs": "turbo dev --filter=docs",
    "gen:expo-package": "bunx turbo gen expo-package",
    "gen:cli-package": "bunx turbo gen cli-package",
    "build": "turbo run build",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\" --ignore-path .gitignore",
    "publish": "bun scripts/publish-package.ts",
    "publish:changed": "bun scripts/publish-changed.ts",
    "publish:all": "turbo run build && bun publish --access public",
    "audit": "bun packages/tscheck/dist/cli.mjs",
    "markforge": "bun packages/markforge/dist/cli.mjs",
    "markforge:build": "turbo run build --filter=@masumdev/markforge",
    "markforge:test": "bun test --cwd packages/markforge"
  },
  "devDependencies": {
    "@turbo/gen": "^2.10.12",
    "prettier": "^3.9.6",
    "turbo": "^2.10.12"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "apps/*",
    "apps/cli/*",
    "packages/*"
  ],
  "overrides": {
    "@babel/core": "^7.25.0",
    "@babel/preset-env": "^7.25.0",
    "react-native-gesture-handler": "~3.3.0"
  }
}
