{
  "name": "@masumdev/{{kebabCase name}}",
  "version": "0.1.0",
  "description": "{{#if description}}{{description}}{{else}}A modern TypeScript library for {{kebabCase name}}.{{/if}}",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
{{#if isCLI}}
  "bin": {
    "{{kebabCase name}}": "./dist/cli.mjs"
  },
{{/if}}
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "typescript",
{{#if isRNCore}}
    "react-native",
    "expo",
    "hooks",
{{/if}}
{{#if isReactWeb}}
    "react",
    "web",
{{/if}}
{{#if isCLI}}
    "cli",
    "terminal",
    "tooling",
{{/if}}
    "{{kebabCase name}}"
  ],
  "author": "Ma'sum",
  "license": "MIT",
  "homepage": "https://lib.masumdev.id/{{kebabCase name}}/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masumrpg/nodejs-lib.git",
    "directory": "packages/{{kebabCase name}}"
  },
  "bugs": {
    "url": "https://github.com/masumrpg/nodejs-lib/issues"
  },
  "devDependencies": {
{{#if isRNCore}}
    "@types/react": "~19.3.0",
{{/if}}
{{#if isReactWeb}}
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
{{/if}}
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  }{{#if hasPeerDeps}},
  "peerDependencies": {
{{#if isRNCore}}
    "react": ">=18",
    "react-native": "*"
{{/if}}
{{#if isReactWeb}}
    "react": ">=18",
    "react-dom": ">=18"
{{/if}}
  }
{{/if}}
}
