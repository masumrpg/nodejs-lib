{
  "name": "@masumdev/{{kebabCase name}}",
  "version": "0.1.0",
  "description": "{{#if description}}{{description}}{{else}}A modern React Native & Expo UI component library for {{kebabCase name}}.{{/if}}",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/module/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    }
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bob build",
    "clean": "rm -rf lib",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "react-native",
    "expo",
    "ui-kit",
    "components",
    "{{kebabCase name}}"
  ],
  "author": "Ma'sum",
  "license": "MIT",
  "homepage": "https://lib.masumdev.id/{{kebabCase name}}/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masumrpg/nodejs-lib.git",
    "directory": "packages/{{kebabCase name}}"
  },
  "bugs": {
    "url": "https://github.com/masumrpg/nodejs-lib/issues"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@babel/preset-env": "^7.25.0",
    "@react-native/babel-preset": "^0.86.0",
    "@types/react": "~19.3.0",
    "react-native-builder-bob": "^0.43.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": "*",
    "expo": "*"
  },
  "publishConfig": {
    "access": "public"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.json"
        }
      ]
    ]
  }
}
