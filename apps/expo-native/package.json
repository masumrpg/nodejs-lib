{
  "name": "expo-native",
  "version": "1.0.0",
  "description": "Expo Development Build demo app for @masumdev/rn-camera-ai and @masumdev/rn-camera-ai-tflite",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "export:android": "expo export --platform android",
    "eas-build-post-install": "cd ../../packages/rn-camera-ai && bun run build && cd ../rn-camera-ai-tflite && bun run build",
    "build:dev": "eas build --platform android --profile development",
    "build:preview": "eas build --platform android --profile preview",
    "build:prod": "eas build --platform android --profile production",
    "build:dev:local": "EAS_LOCAL_BUILD_PLUGIN_PATH=eas-cli-local-build-plugin JAVA_HOME=/home/ma-sum/.gradle/jdks/eclipse_adoptium-17-amd64-linux.2 ANDROID_HOME=/home/ma-sum/Android/Sdk eas build --platform android --profile development --local",
    "build:preview:local": "EAS_LOCAL_BUILD_PLUGIN_PATH=eas-cli-local-build-plugin JAVA_HOME=/home/ma-sum/.gradle/jdks/eclipse_adoptium-17-amd64-linux.2 ANDROID_HOME=/home/ma-sum/Android/Sdk eas build --platform android --profile preview --local",
    "build:prod:local": "EAS_LOCAL_BUILD_PLUGIN_PATH=eas-cli-local-build-plugin JAVA_HOME=/home/ma-sum/.gradle/jdks/eclipse_adoptium-17-amd64-linux.2 ANDROID_HOME=/home/ma-sum/Android/Sdk eas build --platform android --profile production --local"
  },
  "dependencies": {
    "@masumdev/rn-camera-ai": "workspace:*",
    "@masumdev/rn-camera-ai-tflite": "workspace:*",
    "babel-preset-expo": "~58.0.0",
    "expo": "^58.0.0",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.21",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "lucide-react-native": "^1.21.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-fast-tflite": "^3.0.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-nitro-image": "0.15.2",
    "react-native-nitro-modules": "^0.37.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-vision-camera": "5.2.4",
    "react-native-vision-camera-worklets": "^5.2.4",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
