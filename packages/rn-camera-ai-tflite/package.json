{
  "name": "@masumdev/rn-camera-ai-tflite",
  "version": "0.1.0",
  "description": "TensorFlow Lite object detection adapter for @masumdev/rn-camera-ai using react-native-fast-tflite.",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/module/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    }
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bob build",
    "clean": "rm -rf lib",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "test:coverage": "bun test --coverage"
  },
  "keywords": [
    "react-native",
    "expo",
    "tflite",
    "tensorflow-lite",
    "fast-tflite",
    "vision-camera",
    "object-detection",
    "ai"
  ],
  "author": "Ma'sum",
  "license": "MIT",
  "homepage": "https://lib.masumdev.id/rn-camera-ai/tflite-adapter/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masumrpg/nodejs-lib.git",
    "directory": "packages/rn-camera-ai-tflite"
  },
  "bugs": {
    "url": "https://github.com/masumrpg/nodejs-lib/issues"
  },
  "dependencies": {
    "@masumdev/rn-camera-ai": "workspace:*"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@babel/preset-env": "^7.25.0",
    "@react-native/babel-preset": "^0.86.0",
    "@types/react": "~19.3.0",
    "react-native-builder-bob": "^0.43.0",
    "react-native-fast-tflite": "^3.0.1",
    "react-native-nitro-image": "0.15.2",
    "react-native-nitro-modules": "^0.37.0",
    "react-native-vision-camera": "5.2.4",
    "react-native-worklets": "0.13.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "@masumdev/rn-camera-ai": "*",
    "react": ">=18",
    "react-native": "*",
    "react-native-fast-tflite": ">=3.0.0",
    "react-native-nitro-image": "*",
    "react-native-nitro-modules": "^0.37.0",
    "react-native-vision-camera": ">=5.0.0",
    "react-native-worklets": "0.13.x"
  },
  "peerDependenciesMeta": {
    "react-native-fast-tflite": {
      "optional": true
    },
    "react-native-nitro-image": {
      "optional": true
    },
    "react-native-nitro-modules": {
      "optional": true
    },
    "react-native-vision-camera": {
      "optional": true
    },
    "react-native-worklets": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.json"
        }
      ]
    ]
  }
}
