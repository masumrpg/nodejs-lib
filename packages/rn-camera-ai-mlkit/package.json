{
  "name": "@masumdev/rn-camera-ai-mlkit",
  "version": "0.1.1",
  "description": "Google ML Kit on-device OCR & Vision adapter for @masumdev/rn-camera-ai using react-native-vision-camera-mlkit.",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/module/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    }
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bob build",
    "clean": "rm -rf lib",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "test:coverage": "bun test --coverage"
  },
  "keywords": [
    "react-native",
    "expo",
    "mlkit",
    "google-ml-kit",
    "ocr",
    "text-recognition",
    "vision-camera",
    "ai"
  ],
  "author": "Ma'sum",
  "license": "MIT",
  "homepage": "https://lib.masumdev.id/rn-camera-ai/mlkit-ocr/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masumrpg/nodejs-lib.git",
    "directory": "packages/rn-camera-ai-mlkit"
  },
  "bugs": {
    "url": "https://github.com/masumrpg/nodejs-lib/issues"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@babel/preset-env": "^7.25.0",
    "@masumdev/rn-camera-ai": "workspace:*",
    "@react-native/babel-preset": "^0.86.0",
    "@types/react": "~19.3.0",
    "react-native-builder-bob": "^0.43.0",
    "react-native-nitro-modules": "^0.37.0",
    "react-native-vision-camera": "5.2.4",
    "react-native-worklets": "0.13.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "@masumdev/rn-camera-ai": ">=0.4.0",
    "react": ">=18",
    "react-native": "*",
    "react-native-nitro-modules": ">=0.37.0",
    "react-native-vision-camera": ">=5.0.0",
    "react-native-vision-camera-mlkit": ">=2.0.0",
    "react-native-worklets": "*"
  },
  "peerDependenciesMeta": {
    "react-native-nitro-modules": {
      "optional": true
    },
    "react-native-vision-camera": {
      "optional": true
    },
    "react-native-worklets": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.json"
        }
      ]
    ]
  }
}
