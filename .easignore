# Git history (68 MB+ saved; EAS special-cases .git only when explicitly listed here)
.git
.git/

# Dependencies & Caches
node_modules/
**/node_modules/
.pnp
.pnp.js
.expo/
**/.expo/
.turbo/
**/.turbo/
.astro/
**/.astro/

# Native Prebuild Directories (regenerated by EAS prebuild)
android/
ios/
apps/*/android/
apps/*/ios/

# Build Outputs, Media Demos & Local Artifacts
dist/
build/
out/
coverage/
*.apk
*.aab
*.tar.gz
*.gif
*.mp4
*.mov
*.webm
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# Temporary, Logs & Env
.temp/
.temp-reports/
temp/
sample/
**/.temp/
.DS_Store
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.env.local
.env.development.local
.env.test.local
.env.production.local

# Tooling, AI Agents, Generators & E2E Tests
.agents/
.github/
.vscode/
.idea/
tests/
scripts/
turbo/
packages/*/test/
packages/*/tests/
packages/*/__tests__/

# Unrelated Monorepo Apps (keep only package.json for bun.lock workspace resolution)
apps/docs/*
!apps/docs/package.json
apps/expo-go/*
!apps/expo-go/package.json
apps/cli/*/*
!apps/cli/*/package.json

# Unrelated Monorepo Packages (keep only package.json for bun.lock workspace resolution)
packages/markforge/*
!packages/markforge/package.json
packages/tscheck/*
!packages/tscheck/package.json
packages/rn-qr-code/*
!packages/rn-qr-code/package.json
packages/rn-tajweed-verse/*
!packages/rn-tajweed-verse/package.json
packages/rn-ui/*
!packages/rn-ui/package.json

# Note: packages/rn-camera-ai and packages/rn-camera-ai-tflite (including their lib/ and src/)
# are intentionally NOT ignored so EAS can bundle them directly.
